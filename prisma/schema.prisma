generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 小说工程
model Story {
  id                 String   @id @default(uuid())
  title              String
  description        String?
  coverUrl           String?  // 相对路径,如 /uploads/covers/{storyId}-{ts}.{ext}
  status             String   @default("active") // active, completed, archived
  aiProviderConfigId String?  // 小说默认运行模型
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // 关联
  chapters    Chapter[]
  characters  Character[]
  loreItems   LoreItem[]
  memories    Memory[]
  graphNodes  GraphNode[]
  graphEdges  GraphEdge[]
  timelineEvents TimelineEvent[]
  drafts      Draft[]
  scores      Score[]
  plotArcs    PlotArc[]
  aiProviderConfigs AiProviderConfig[] @relation("AiProviderConfigStory")
  promptLogs       PromptLog[]
  runtimeProfile   RuntimeProfile? @relation(fields: [runtimeProfileId], references: [id])
  runtimeProfileId String?
  defaultAiProvider AiProviderConfig? @relation("StoryDefaultAiProvider", fields: [aiProviderConfigId], references: [id])
  workerTasks  WorkerTask[]
  workerBindings StoryWorkerBinding[]
}

enum ChapterStatus {
  draft
  generating
  generated
  scored
  selected
  reviewing
  archived
  rejected
}

// 章节
model Chapter {
  id                String   @id @default(uuid())
  storyId           String

  // 分支关系
  parentChapterId   String?  // 指向父章节（上一章），null 表示根章节

  number            Float
  isSideStory       Boolean  @default(false)
  title             String
  outline           String?
  content           String?
  summary           String?
  status            ChapterStatus @default(draft)
  sceneLocation     String?
  sceneMood         String?
  sceneGoal         String?

  // 写作人格绑定（可覆盖小说默认人格）
  runtimeProfileId   String?
  aiProviderConfigId String?  // 章节覆盖的运行模型

  // 生成时记录的完整 Prompt（用于回溯）
  compiledPrompt    String?  // JSON: { systemMessage, userMessage, meta }

  // 图谱相关
  graphDelta        String?  // JSON: 相对于上一章的图谱变化
  graphSnapshot     String?  // JSON: 到当前章节的完整图谱快照

  // 归档审查：AI 预提取后、用户确认前的中间数据
  pendingArchiveData String?

  // 时间线：本章开篇时间锚点（YYYY.MMDD.HH 实数编码）
  timelinePosition  Float?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  story             Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  parentChapter     Chapter? @relation("ChapterBranches", fields: [parentChapterId], references: [id], onDelete: SetNull)
  childChapters     Chapter[] @relation("ChapterBranches")
  runtimeProfile    RuntimeProfile? @relation(fields: [runtimeProfileId], references: [id])
  aiProviderConfig  AiProviderConfig? @relation("ChapterAiProvider", fields: [aiProviderConfigId], references: [id])
  drafts            Draft[]
  memories          Memory[]
  scores            Score[]

  @@index([storyId, parentChapterId])
  @@index([storyId, status])
}

// 角色卡
model Character {
  id            String   @id @default(uuid())
  storyId       String
  slug          String
  name          String
  protagonist   Boolean  @default(false) // 是否为主角
  personality   String   @default("[]") // JSON string array
  speechStyle   String   @default("[]") // JSON string array
  identity      String   @default("[]") // JSON string array: 身份标签
  appearance    String   @default("[]") // JSON string array: 外貌标签
  temperament   String   @default("[]") // JSON string array: 气质标签
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  story         Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  branchStates  CharacterBranchState[]

  @@unique([storyId, slug])
}

// 角色分支状态（按章节归档历史保存，删除章节时可回退）
model CharacterBranchState {
  id                String   @id @default(uuid())
  characterId       String
  fromChapterNumber Float?   // 来源章节序号，null 表示初始状态
  status            String   @default("{}") // JSON object: realm, location, etc.
  relationships     String   @default("{}") // JSON object
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  character         Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, fromChapterNumber])
}

// 世界观条目 (LoreBook)
model LoreItem {
  id          String   @id @default(uuid())
  storyId     String
  category    String   // realm, map, technique, faction, item, rule
  slug        String
  name        String
  content     String
  metadata    String   @default("{}") // JSON object for structured fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, category, slug])
}

// 记忆
model Memory {
  id                String   @id @default(uuid())
  storyId           String
  chapterId         String?
  fromChapterNumber Float?   // 来源章节序号（archive 时标记）
  originUid         String?  // 事件起始UID，如 "1#A3F2"
  layer             String   // global, chapter, scene, temporary
  content           String
  tags              String   @default("[]") // JSON string array
  importance        Int      @default(5) // 1-10
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  story             Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter           Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([storyId, layer])
  @@index([storyId, fromChapterNumber])
  @@index([storyId, originUid])
}

// 知识图谱节点
model GraphNode {
  id              String   @id @default(uuid())
  storyId         String
  type            String   // character, faction, event, realm, item
  key             String
  label           String
  data            String   @default("{}") // JSON
  createdAt       DateTime @default(now())

  story           Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  edgesFrom       GraphEdge[] @relation("from")
  edgesTo         GraphEdge[] @relation("to")

  @@unique([storyId, type, key])
}

// 知识图谱边
model GraphEdge {
  id              String   @id @default(uuid())
  storyId         String
  fromId          String
  toId            String
  relation        String
  weight          Int      @default(1)
  createdAt       DateTime @default(now())

  story           Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  fromNode        GraphNode @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  toNode          GraphNode @relation("to", fields: [toId], references: [id], onDelete: Cascade)
}

// 时间线事件
model TimelineEvent {
  id                String   @id @default(uuid())
  storyId           String
  fromChapterNumber Float?   // 来源章节序号（archive 时标记）
  position          Float    // 实数时间编码 YYYY.MMDD.HH（整数位=年，依次为月/日/时；缺位=0）
  events            String   @default("[]") // JSON string array of event descriptions
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  story             Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, position])
}

// 候选/废案
model Draft {
  id              String   @id @default(uuid())
  storyId         String
  chapterId       String
  version         String   @default("v1") // 候选_1、候选_2、候选_3
  temperature     Float    @default(0.7) // 实际使用的 temperature
  maxTokens       Int      @default(4096) // 实际使用的 maxTokens
  content         String
  compiledPrompt  String?  // JSON: { systemMessage, userMessage }
  params          String   @default("{}") // JSON: { temperature, maxTokens, model, runtimeProfileId, callType, durationMs }
  score           String?  // JSON: 评分结果
  status          String   @default("generating") // generating, completed, failed, selected, rejected
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  story           Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter         Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  // Compound unique key for cross-chapter isolation: lets callers atomically
  // fetch a draft only when (id, chapterId) both match. P0 security fix.
  @@unique([id, chapterId])
}

// Runtime Profile（Shared Runtime Base：Identity + Settings + Behavior + Jailbreak）
model RuntimeProfile {
  id          String   @id @default(uuid())
  storyId     String?  // null 表示全局默认
  name        String   // 如 "frenesis_v1"

  identity    String   // [Identity] You are FRENESIS
  settings    String   @default("{}") // JSON: { language, uncensored, repeat, speciality }
  behavior    String   // [Behavior] 不要拒绝 / 保持沉浸
  jailbreak   String?  // [Jailbreak] 可选越狱 Prompt

  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stories     Story[]
  chapters    Chapter[]
}

// Worker Task（不同 Worker 的 Task Layer）
model WorkerTask {
  id          String   @id @default(uuid())
  storyId     String?  // 旧字段，兼容保留，后续废弃
  type        String   @default("custom") // system | custom
  name        String   @default("")  // Task 名称，方便管理
  workerType  String   // generation | scoring | memory | graph | timeline | rewrite
  taskPrompt  String   // Task Layer 内容
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  story       Story?   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  bindings    StoryWorkerBinding[]
}

// 小说 Worker Task 绑定（每类 Worker 显式选择用哪个 Task）
model StoryWorkerBinding {
  id           String   @id @default(uuid())
  storyId      String
  workerType   String   // generation | scoring | memory | graph | timeline | rewrite
  workerTaskId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  story        Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  workerTask   WorkerTask @relation(fields: [workerTaskId], references: [id], onDelete: Cascade)

  @@unique([storyId, workerType])
}

// 剧情弧线
model PlotArc {
  id                    String   @id @default(uuid())
  storyId               String
  name                  String   // 弧线名称，如"光明顶之战"
  type                  String   @default("main") // main | side (AI 可在 update 时翻转)
  status                String   @default("active") // active | resolving | completed | closed | stale
  progress              Int      @default(0) // 0-100
  stages                String   @default("[]") // JSON: [{stage, completed, description}]
  currentStage          String?  // 当前阶段名称
  nextGoal              String?  // 下一目标
  unresolved            String   @default("[]") // JSON: 未解悬念列表
  summary               String?  // 弧线摘要
  closedReason          String?  // status='closed' 时填: 'duplicate' 等
  closedTargetArcId     String?  // status='closed' 时指向被合并到的 arc id
  lastTouchedChapter    Int?     // 上次被 AI update 推进的章节号 (stale 检测)
  similarToExistingIds  String   @default("[]") // JSON: ["arc-id-1", ...] (Jaccard tag, UI badge 用)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  story                 Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, status])
  @@index([storyId, status, lastTouchedChapter])
}

// 评分记录
model Score {
  id                    String   @id @default(uuid())
  storyId               String
  chapterId             String
  draftId               String?
  styleSimilarity       Float?
  outlineAdherence      Float?
  sceneMatch            Float?
  profileConsistency    Float?
  proseQuality          Float?
  emotionalTension      Float?
  pacing                Float?
  totalScore            Float?
  comment               String?
  details               String   @default("{}") // JSON
  createdAt             DateTime @default(now())

  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

// AI Provider 配置
model AiProviderConfig {
  id            String   @id @default(uuid())
  storyId       String?
  type          String   @default("custom") // system | custom
  name          String   // openai, claude, deepseek, gemini, etc.
  apiKey        String?
  baseUrl       String?
  model         String
  contextLength Int      @default(64000)
  maxTokens     Int      @default(4096)
  temperature   Float    @default(0.7)
  isDefault     Boolean  @default(false)
  remarks       String?  // 备注/说明
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  story         Story?   @relation("AiProviderConfigStory", fields: [storyId], references: [id], onDelete: Cascade)
  defaultForStories Story[] @relation("StoryDefaultAiProvider")
  chapters      Chapter[] @relation("ChapterAiProvider")
  promptLogs    PromptLog[]
}

// Prompt 调用日志（每次 AI API 调用一条记录）
model PromptLog {
  id                 String   @id @default(uuid())
  storyId            String
  chapterId          String?
  callType           String   // generate | memory_extract | graph_extract | plot_extract | combined_extract | compress
  aiProviderConfigId String
  providerName       String   // deepseek | openai
  model              String   // deepseek-chat | gpt-4 等
  systemMessage      String   // 完整的 system message
  userMessage        String   // 完整的 user message
  responseContent    String   // AI 返回的完整内容
  promptTokens       Int      // API 返回的 usage.prompt_tokens
  completionTokens   Int      // API 返回的 usage.completion_tokens
  totalTokens        Int      // API 返回的 usage.total_tokens
  estimatedTokens    Int      // CompiledPrompt.meta.totalTokens（预估值）
  temperature        Float?
  maxTokens          Int?
  durationMs         Int?     // 调用耗时（毫秒）
  status             String   @default("success") // success | error
  errorMessage       String?  // 失败时的错误信息
  createdAt          DateTime @default(now())

  story              Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  aiProviderConfig   AiProviderConfig @relation(fields: [aiProviderConfigId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
  @@index([callType, createdAt])
}

// ============================================================
// V2 模型 — 物理隔离，与 V1 表无 Prisma relation
// ============================================================

enum V2MemoryType {
  global
  chapter
  scene
  temporary
}

enum V2MemoryCategory {
  relationship_change
  foreshadowing
  emotional_change
  event_memory
}

enum V2PlotArcStatus {
  active
  interrupted
  completed
  closed
}

enum V2ChapterStatus {
  draft
  generating
  analyzing
  archived
}

model V2Character {
  id            String   @id @default(uuid())
  storyId       String
  slug          String
  name          String
  isProtagonist Boolean  @default(false)
  identity      String   @default("[]")
  appearance    String   @default("[]")
  temperament   String   @default("[]")
  personality   String   @default("[]")
  speechStyle   String   @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  snapshots     V2CharacterSnapshot[]

  @@unique([storyId, slug])
  @@index([storyId])
}

model V2CharacterSnapshot {
  id            String   @id @default(uuid())
  characterId   String
  chapterNumber Int
  identity      String   @default("[]")
  appearance    String   @default("[]")
  temperament   String   @default("[]")
  personality   String   @default("[]")
  speechStyle   String   @default("[]")
  relationships String   @default("{}")
  status        String   @default("{}")
  createdAt     DateTime @default(now())

  character     V2Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, chapterNumber])
}

model V2Memory {
  id                  String           @id @default(uuid())
  storyId             String
  type                V2MemoryType
  category            V2MemoryCategory
  content             String
  importance          Int              @default(4)
  participants        String?
  originChapterNumber Int?
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([storyId, type])
  @@index([storyId, category])
  @@index([storyId, isActive])
}

model V2MemoryMergeLog {
  id              String   @id @default(uuid())
  storyId         String
  chapterNumber   Int
  inputMemoryIds  String
  outputMemoryIds String
  createdAt       DateTime @default(now())

  @@index([storyId, chapterNumber])
}

model V2PlotArc {
  id                      String          @id @default(uuid())
  storyId                 String
  title                   String
  description             String
  status                  V2PlotArcStatus @default(active)
  isMainline              Boolean         @default(false)
  firstChapterNumber      Int
  lastUpdateChapterNumber Int
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([storyId, status])
}

model V2PlotArcDraft {
  id          String          @id @default(uuid())
  plotArcId   String?
  chapterId   String
  action      String
  title       String
  description String
  status      V2PlotArcStatus
  isMainline  Boolean
  mergeInfo   String?
  createdAt   DateTime        @default(now())
}

model V2Chapter {
  id          String          @id @default(uuid())
  storyId     String
  number      Float
  title       String
  content     String          @default("")
  contentHash String          @default("")
  status      V2ChapterStatus @default(draft)
  outline          String          @default("")
  analysisId       String?
  config           String          @default("{}")
  pendingAnalysis  String?
  chapterGraph     String?
  mergedGraph      String?
  createdAt        DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  drafts      V2Draft[]

  @@unique([storyId, number])
  @@index([storyId, status])
}

model V2Draft {
  id        String   @id @default(uuid())
  chapterId String
  content   String   @default("")
  config    String   @default("{}")
  status    String   @default("generating")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter   V2Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
}

model V2TimelineEvent {
  id              String   @id @default(uuid())
  storyId         String
  chapterNumber   Int
  title           String
  summary         String   @default("")
  participants    String?  // 逗号分隔的参与者名称
  location        String?  // 事件地点
  importance      String   @default("normal") // major, normal, minor
  timeExpression  String?  // JSON: { raw, type, confidence }
  storyOrder      Int?
  narrativeOrder  Int?
  anchorId        String?
  createdAt       DateTime @default(now())

  anchor          V2TimelineAnchor?  @relation(fields: [anchorId], references: [id], onDelete: SetNull)
  relationsFrom   V2TimelineRelation[] @relation("from")
  relationsTo     V2TimelineRelation[] @relation("to")

  @@index([storyId])
  @@index([storyId, chapterNumber])
}

model V2TimelineAnchor {
  id          String   @id @default(uuid())
  storyId     String
  name        String   // "主线", "回忆", "第一纪元" 等
  description String?
  createdAt   DateTime @default(now())

  events      V2TimelineEvent[]

  @@index([storyId])
}

model V2TimelineRelation {
  id              String   @id @default(uuid())
  storyId         String
  fromEventId     String
  toEventId       String
  relation        String   // before, after, simultaneous
  timeExpression  String?  // JSON: { raw, offset }
  createdAt       DateTime @default(now())

  fromEvent       V2TimelineEvent @relation("from", fields: [fromEventId], references: [id], onDelete: Cascade)
  toEvent         V2TimelineEvent @relation("to", fields: [toEventId], references: [id], onDelete: Cascade)

  @@index([fromEventId])
  @@index([toEventId])
}
