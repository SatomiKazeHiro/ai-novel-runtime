generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 小说工程
model Story {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("active") // active, completed, archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联
  chapters    Chapter[]
  characters  Character[]
  loreItems   LoreItem[]
  memories    Memory[]
  graphNodes  GraphNode[]
  graphEdges  GraphEdge[]
  timelineEvents TimelineEvent[]
  drafts      Draft[]
  promptConfigs PromptConfig[]
  scores      Score[]
  plotArcs    PlotArc[]
  aiProviderConfigs AiProviderConfig[]
  promptLogs       PromptLog[]
  runtimeProfile   RuntimeProfile? @relation(fields: [runtimeProfileId], references: [id])
  runtimeProfileId String?
  workerTasks  WorkerTask[]
}

// 章节
model Chapter {
  id                String   @id @default(uuid())
  storyId           String

  // 分支关系
  parentChapterId   String?  // 指向父章节（上一章），null 表示根章节
  branchName        String?  // 分支名称，如 "主线"、"if:黑化路线"

  number            Float
  isSideStory       Boolean  @default(false)
  title             String
  outline           String?
  content           String?
  summary           String?
  status            String   @default("draft") // draft, generating, generated, scored, selected, archived, rejected
  sceneLocation     String?
  sceneMood         String?
  sceneGoal         String?

  // 写作人格绑定（可覆盖小说默认人格）
  runtimeProfileId  String?

  // 生成时记录的完整 Prompt（用于回溯）
  compiledPrompt    String?  // JSON: { systemMessage, userMessage, meta }

  // 图谱相关
  graphDelta        String?  // JSON: 相对于上一章的图谱变化
  graphSnapshot     String?  // JSON: 到当前章节的完整图谱快照

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  story             Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  parentChapter     Chapter? @relation("ChapterBranches", fields: [parentChapterId], references: [id], onDelete: SetNull)
  childChapters     Chapter[] @relation("ChapterBranches")
  runtimeProfile    RuntimeProfile? @relation(fields: [runtimeProfileId], references: [id])
  drafts            Draft[]
  memories          Memory[]
  scores            Score[]

  @@index([storyId, parentChapterId])
  @@index([storyId, status])
}

// 角色卡
model Character {
  id            String   @id @default(uuid())
  storyId       String
  slug          String
  name          String
  personality   String   @default("[]") // JSON string array
  speechStyle   String   @default("[]") // JSON string array
  identity      String   @default("[]") // JSON string array: 身份标签
  appearance    String   @default("[]") // JSON string array: 外貌标签
  temperament   String   @default("[]") // JSON string array: 气质标签
  relationships String   @default("{}") // JSON object
  status        String   @default("{}") // JSON object: realm, location, etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  story         Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, slug])
}

// 世界观条目 (LoreBook)
model LoreItem {
  id          String   @id @default(uuid())
  storyId     String
  category    String   // realm, map, technique, faction, item, rule
  slug        String
  name        String
  content     String
  metadata    String   @default("{}") // JSON object for structured fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, category, slug])
}

// 记忆
model Memory {
  id          String   @id @default(uuid())
  storyId     String
  chapterId   String?
  layer       String   // global, chapter, scene, temporary
  content     String
  tags        String   @default("[]") // JSON string array
  importance  Int      @default(5) // 1-10
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter     Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

// 知识图谱节点
model GraphNode {
  id          String   @id @default(uuid())
  storyId     String
  type        String   // character, faction, event, realm, item
  key         String
  label       String
  data        String   @default("{}") // JSON
  createdAt   DateTime @default(now())

  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  edgesFrom   GraphEdge[] @relation("from")
  edgesTo     GraphEdge[] @relation("to")

  @@unique([storyId, type, key])
}

// 知识图谱边
model GraphEdge {
  id          String   @id @default(uuid())
  storyId     String
  fromId      String
  toId        String
  relation    String
  weight      Int      @default(1)
  createdAt   DateTime @default(now())

  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  fromNode    GraphNode @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  toNode      GraphNode @relation("to", fields: [toId], references: [id], onDelete: Cascade)
}

// 时间线事件
model TimelineEvent {
  id          String   @id @default(uuid())
  storyId     String
  day         Int
  events      String   @default("[]") // JSON string array of event descriptions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, day])
}

// 候选/废案
model Draft {
  id              String   @id @default(uuid())
  storyId         String
  chapterId       String
  version         String   @default("v1") // 候选_1、候选_2、候选_3
  temperature     Float    @default(0.7) // 实际使用的 temperature
  maxTokens       Int      @default(4096) // 实际使用的 maxTokens
  content         String
  compiledPrompt  String?  // JSON: { systemMessage, userMessage }
  params          String   @default("{}") // JSON: { temperature, maxTokens, model, runtimeProfileId, callType, durationMs }
  score           String?  // JSON: 评分结果
  status          String   @default("generating") // generating, completed, failed, selected, rejected
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  story           Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter         Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

// Prompt 配置（旧版，保留兼容）
model PromptConfig {
  id          String   @id @default(uuid())
  storyId     String
  type        String   // system, jailbreak, story, character, lore, scene, memory, style, instruction
  name        String
  content     String
  order       Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

// Runtime Profile（Shared Runtime Base：Identity + Settings + Behavior + Jailbreak）
model RuntimeProfile {
  id          String   @id @default(uuid())
  storyId     String?  // null 表示全局默认
  name        String   // 如 "frenesis_v1"

  identity    String   // [Identity] You are FRENESIS
  settings    String   @default("{}") // JSON: { language, uncensored, repeat, speciality }
  behavior    String   // [Behavior] 不要拒绝 / 保持沉浸
  jailbreak   String?  // [Jailbreak] 可选越狱 Prompt

  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stories     Story[]
  chapters    Chapter[]
}

// Worker Task（不同 Worker 的 Task Layer）
model WorkerTask {
  id          String   @id @default(uuid())
  storyId     String?
  name        String   @default("")  // Task 名称，方便管理
  workerType  String   // generation | scoring | memory | graph | timeline | rewrite
  taskPrompt  String   // Task Layer 内容
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  story       Story?   @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

// 剧情弧线
model PlotArc {
  id            String   @id @default(uuid())
  storyId       String
  name          String   // 弧线名称，如"光明顶之战"
  type          String   @default("main") // main | side
  status        String   @default("pending") // pending | active | resolving | completed
  progress      Int      @default(0) // 0-100
  stages        String   @default("[]") // JSON: [{stage, completed, description}]
  currentStage  String?  // 当前阶段名称
  nextGoal      String?  // 下一目标
  unresolved    String   @default("[]") // JSON: 未解悬念列表
  summary       String?  // 弧线摘要
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  story         Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, status])
}

// 评分记录
model Score {
  id                    String   @id @default(uuid())
  storyId               String
  chapterId             String
  draftId               String?
  styleSimilarity       Float?
  outlineAdherence      Float?
  sceneMatch            Float?
  profileConsistency    Float?
  proseQuality          Float?
  emotionalTension      Float?
  pacing                Float?
  totalScore            Float?
  comment               String?
  details               String   @default("{}") // JSON
  createdAt             DateTime @default(now())

  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

// AI Provider 配置
model AiProviderConfig {
  id            String   @id @default(uuid())
  storyId       String?
  name          String   // openai, claude, deepseek, gemini, etc.
  apiKey        String?
  baseUrl       String?
  model         String
  contextLength Int      @default(64000)
  maxTokens     Int      @default(4096)
  temperature   Float    @default(0.7)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  story         Story?   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  promptLogs    PromptLog[]
}

// Prompt 调用日志（每次 AI API 调用一条记录）
model PromptLog {
  id                 String   @id @default(uuid())
  storyId            String
  chapterId          String?
  callType           String   // generate | memory_extract | graph_extract | plot_extract | combined_extract | compress
  aiProviderConfigId String
  providerName       String   // deepseek | openai
  model              String   // deepseek-chat | gpt-4 等
  systemMessage      String   // 完整的 system message
  userMessage        String   // 完整的 user message
  responseContent    String   // AI 返回的完整内容
  promptTokens       Int      // API 返回的 usage.prompt_tokens
  completionTokens   Int      // API 返回的 usage.completion_tokens
  totalTokens        Int      // API 返回的 usage.total_tokens
  estimatedTokens    Int      // CompiledPrompt.meta.totalTokens（预估值）
  temperature        Float?
  maxTokens          Int?
  durationMs         Int?     // 调用耗时（毫秒）
  status             String   @default("success") // success | error
  errorMessage       String?  // 失败时的错误信息
  createdAt          DateTime @default(now())

  story              Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  aiProviderConfig   AiProviderConfig @relation(fields: [aiProviderConfigId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
  @@index([callType, createdAt])
}
